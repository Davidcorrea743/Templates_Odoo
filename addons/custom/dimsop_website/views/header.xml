<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="dimsop_header" inherit_id="website.layout" name="Dimsop Header">
        <xpath expr="//header[1]" position="replace">
            <header id="dimsop_header" class="o_header dimsop-header">
                <div class="dimsop-header-main container d-flex align-items-center justify-content-between py-2">
                    <!-- Logo -->
                    <a class="dimsop-logo" href="/" title="Dimsop">
                        <img src="/dimsop_website/static/src/img/logos/dimsop-logo.png"
                             alt="Dimsop" class="img-fluid"/>
                    </a>

                    <!-- Navegacion desktop -->
                    <nav class="dimsop-nav d-none d-lg-flex">
                        <ul class="nav">
                            <t t-foreach="website.menu_id.child_id" t-as="menu">
                                <li class="nav-item">
                                    <a class="nav-link" t-att-href="menu.url" t-esc="menu.name"/>
                                </li>
                            </t>
                        </ul>
                    </nav>

                    <!-- Herramientas -->
                    <div class="dimsop-tools d-flex align-items-center">
                        <!-- Buscador expand-on-hover -->
                        <form class="dimsop-search me-2" action="/website/search" method="get" role="search">
                            <div class="dimsop-search-wrap" id="dimsop-search-wrap">
                                <i class="fa fa-search dimsop-search-icon" aria-hidden="true"></i>
                                <input type="text" class="form-control" name="search"
                                       placeholder="Buscar..." aria-label="Buscar"/>
                            </div>
                        </form>

                        <!-- Idioma -->
                        <t t-call="website.language_selector"/>

                        <!-- Dark mode toggle -->
                        <button id="dimsop-dark-toggle" class="btn btn-sm btn-outline-light ms-2"
                                type="button" title="Cambiar modo claro/oscuro" aria-label="Modo oscuro">
                            <i class="fa fa-moon-o" aria-hidden="true"></i>
                        </button>
                    </div>

                    <!-- Burger mobile -->
                    <button class="dimsop-burger d-lg-none" type="button"
                            id="dimsop-burger-toggle"
                            aria-expanded="false" aria-controls="dimsop-mobile-nav"
                            aria-label="Abrir menu de navegacion">
                        <i class="fa fa-bars fa-2x" aria-hidden="true"></i>
                    </button>
                </div>

                <!-- Menu movil -->
                <div class="d-lg-none" id="dimsop-mobile-nav" style="display: none;">
                    <ul class="nav flex-column px-3 pb-3">
                        <t t-foreach="website.menu_id.child_id" t-as="menu">
                            <li class="nav-item">
                                <a class="nav-link" t-att-href="menu.url" t-esc="menu.name"/>
                            </li>
                        </t>
                    </ul>
                </div>
            </header>
            <script>
                (function() {
                    // Busqueda expand on click
                    var wrap = document.getElementById('dimsop-search-wrap');
                    if (wrap) {
                        wrap.addEventListener('click', function(e) {
                            if (e.target.tagName === 'INPUT') return;
                            wrap.classList.toggle('dimsop-search-open');
                            var input = wrap.querySelector('input');
                            if (wrap.classList.contains('dimsop-search-open') &amp;&amp; input) {
                                input.focus();
                            }
                        });
                        document.addEventListener('click', function(e) {
                            if (!wrap.contains(e.target)) {
                                wrap.classList.remove('dimsop-search-open');
                            }
                        });
                    }

                    // Burger menu movil
                    var burger = document.getElementById('dimsop-burger-toggle');
                    var mobileNav = document.getElementById('dimsop-mobile-nav');
                    if (burger &amp;&amp; mobileNav) {
                        burger.addEventListener('click', function() {
                            var isOpen = mobileNav.style.display === 'block';
                            mobileNav.style.display = isOpen ? 'none' : 'block';
                            burger.setAttribute('aria-expanded', !isOpen);
                        });
                        document.addEventListener('click', function(e) {
                            if (!burger.contains(e.target) &amp;&amp; !mobileNav.contains(e.target)) {
                                mobileNav.style.display = 'none';
                                burger.setAttribute('aria-expanded', 'false');
                            }
                        });
                    }
                })();
            </script>
        </xpath>
    </template>
</odoo>
