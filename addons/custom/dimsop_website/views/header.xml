<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="dimsop_header" inherit_id="website.layout" name="Dimsop Header">
        <xpath expr="//header[1]" position="replace">
            <header id="dimsop_header" class="o_header dimsop-header">
                <!-- Scroll progress bar -->
                <div class="dimsop-scroll-progress" id="dimsop-scroll-progress"></div>

                <div class="dimsop-header-main container d-flex align-items-center justify-content-between py-2">
                    <!-- Logo -->
                    <a class="dimsop-logo" href="/" title="Dimsop">
                        <img src="/dimsop_website/static/src/img/logos/dimsop-logo.png"
                             alt="Dimsop" class="img-fluid"/>
                    </a>

                    <!-- Navegacion desktop -->
                    <nav class="dimsop-nav d-none d-lg-flex" aria-label="Navegacion principal">
                        <ul class="nav">
                            <li class="nav-item">
                                <a class="nav-link" href="/">Inicio</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/#nosotros">Nosotros</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/#unidades">Unidades de Negocio</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/#aliados">Aliados</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/blog">Blog</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/#contacto">Contacto</a>
                            </li>
                        </ul>
                    </nav>

                    <!-- Herramientas -->
                    <div class="dimsop-tools d-flex align-items-center">
                        <!-- Buscador expand-on-hover -->
                        <form class="dimsop-search me-2" action="/website/search" method="get" role="search">
                            <div class="dimsop-search-wrap" id="dimsop-search-wrap">
                                <i class="fa fa-search dimsop-search-icon" aria-hidden="true"></i>
                                <input type="text" class="form-control" name="search"
                                       placeholder="Buscar..." aria-label="Buscar"/>
                            </div>
                        </form>

                        <!-- Dark mode toggle (onclick — always works, no script dependency) -->
                        <button id="dimsop-dark-toggle" class="btn btn-sm btn-outline-light ms-2"
                                type="button" title="Cambiar modo claro/oscuro" aria-label="Modo oscuro"
                                onclick="var d=document.documentElement;var n=d.getAttribute('data-theme')==='dark'?'light':'dark';d.setAttribute('data-theme',n);try{localStorage.setItem('dimsop-theme',n)}catch(e){}var i=this.querySelector('i');if(i)i.className=n==='dark'?'fa fa-sun-o':'fa fa-moon-o'">
                            <i class="fa fa-moon-o" aria-hidden="true"></i>
                        </button>

                        <!-- CTA: Únete -->
                        <a href="#" class="dimsop-btn-cta ms-2 d-none d-lg-inline-flex align-items-center"
                           data-bs-toggle="modal" data-bs-target="#dimsop-carreras-modal">
                            <i class="fa fa-users me-1" aria-hidden="true"></i> Trabaja con nosotros
                        </a>
                    </div>

                    <!-- Burger mobile -->
                    <button class="dimsop-burger d-lg-none" type="button"
                            id="dimsop-burger-toggle"
                            aria-expanded="false" aria-controls="dimsop-mobile-nav"
                            aria-label="Abrir menu de navegacion">
                        <span class="dimsop-burger-line"></span>
                        <span class="dimsop-burger-line"></span>
                        <span class="dimsop-burger-line"></span>
                    </button>
                </div>

                <!-- Menu movil -->
                <div class="d-lg-none dimsop-mobile-panel" id="dimsop-mobile-nav" aria-hidden="true">
                    <nav aria-label="Navegacion movil">
                        <ul class="nav flex-column">
                            <li class="nav-item">
                                <a class="nav-link" href="/">Inicio</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/#nosotros">Nosotros</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/#unidades">Unidades de Negocio</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/#aliados">Aliados</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/blog">Blog</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/#contacto">Contacto</a>
                            </li>
                            <li class="nav-item mt-2">
                                <a class="nav-link dimsop-btn-cta-mobile" href="#"
                                   data-bs-toggle="modal" data-bs-target="#dimsop-carreras-modal">
                                    <i class="fa fa-users me-1" aria-hidden="true"></i> Trabaja con nosotros
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            </header>
        </xpath>
    </template>
</odoo>
