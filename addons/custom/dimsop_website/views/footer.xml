<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        PIE DE PAGINA / FOOTER
          - 4 columnas: Logo+Contacto | Navegacion | Venezuela+Mapa | USA+Mapa
          - Barra inferior: Copyright + Redes sociales
    -->
    <template id="dimsop_footer" inherit_id="website.layout" name="Dimsop Footer">
        <xpath expr="//footer[1]" position="replace">
            <footer id="dimsop_footer" class="dimsop-footer text-white">
                <div class="container py-5">
                    <div class="row g-4">
                        <!-- Columna 1: Logo + Contacto general -->
                        <div class="col-lg-3 col-md-6">
                            <a class="dimsop-logo d-inline-block mb-3" href="/">
                                <img src="/dimsop_website/static/src/img/logos/logo_Dimsop_Footer.png"
                                     alt="Dimsop" class="img-fluid" style="max-height: 60px;"/>
                            </a>
                            <p class="mb-2" style="font-size: .9rem;">
                                <i class="fa fa-envelope me-2" aria-hidden="true"></i>
                                <span t-field="res_company.email"/>
                            </p>
                            <p class="mb-0" style="font-size: .9rem;">
                                <i class="fa fa-phone me-2" aria-hidden="true"></i>
                                +58 212-819.54.00
                            </p>
                        </div>

                        <!-- Columna 2: Navegacion -->
                        <div class="col-lg-3 col-md-6">
                            <h5 class="dimsop-footer-title">Navegaci&#243;n</h5>
                            <ul class="list-unstyled">
                                <li><a href="/">Inicio</a></li>
                                <li><a href="/#nosotros">Nosotros</a></li>
                                <li><a href="/#unidades">Unidades de Negocio</a></li>
                                <li><a href="/blog">Blog</a></li>
                                <li><a href="/#contacto">Contacto</a></li>
                                <li><a href="/privacy">Pol&#237;ticas de Privacidad</a></li>
                                <li><a href="#" data-bs-toggle="modal" data-bs-target="#dimsop-carreras-modal">Forma parte de nuestro equipo</a></li>
                            </ul>
                        </div>

                        <!-- Columna 3: Venezuela -->
                        <div class="col-lg-3 col-md-6 dimsop-footer-map-col">
                            <h5 class="dimsop-footer-title">Venezuela</h5>
                            <p style="font-size: .85rem; line-height: 1.5;">
                                Calle Sanatorio del Avila, Centro Empresarial Ciudad Center, Torre C, Piso 4, Ofic. 41-C, Municipio Sucre &#8211; Estado Miranda
                            </p>
                            <div class="dimsop-footer-map-wrap">
                                <iframe class="dimsop-footer-map"
                                        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3922.7!2d-66.858!3d10.491!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8c2ae40f9e1e6a5d%3A0x1234567890abcdef!2sCentro+Empresarial+Ciudad+Center+Torre+C!5e0!3m2!1ses!2sve!4v1700000000000"
                                        allowfullscreen="" loading="lazy"
                                        title="Ubicacion Venezuela"></iframe>
                            </div>
                            <a href="https://www.google.com/maps/search/Centro+Empresarial+Ciudad+Center+Torre+C+Caracas+Venezuela"
                               target="_blank" class="dimsop-footer-map-link">
                                Abrir en Google Maps &#8594;
                            </a>
                            <p class="mt-2 mb-0" style="font-size: .85rem;">
                                <i class="fa fa-phone me-1" aria-hidden="true"></i>
                                +58 212-819.54.00
                            </p>
                            <p class="mt-1 mb-0" style="font-size: .85rem;">
                                <i class="fa fa-id-card me-1" aria-hidden="true"></i>
                                RIF: J-41137726-0
                            </p>
                        </div>

                        <!-- Columna 4: Estados Unidos -->
                        <div class="col-lg-3 col-md-6 dimsop-footer-map-col">
                            <h5 class="dimsop-footer-title">Estados Unidos</h5>
                            <p style="font-size: .85rem; line-height: 1.5;">
                                4995 NW 72 Nd AVE STE 205, Miami, Florida
                            </p>
                            <div class="dimsop-footer-map-wrap">
                                <iframe class="dimsop-footer-map"
                                        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3585.5!2d-80.324!3d25.814!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x88d9bba03c1e6e3f%3A0x1234567890abcdef!2s4995+NW+72nd+Ave+STE+205+Miami+FL!5e0!3m2!1ses!2sus!4v1700000000000"
                                        allowfullscreen="" loading="lazy"
                                        title="Ubicacion Estados Unidos"></iframe>
                            </div>
                            <a href="https://www.google.com/maps/search/4995+NW+72+N+Ave+STE+205+Miami+Florida"
                               target="_blank" class="dimsop-footer-map-link">
                                Abrir en Google Maps &#8594;
                            </a>
                            <p class="mt-2 mb-0" style="font-size: .85rem;">
                                <i class="fa fa-phone me-1" aria-hidden="true"></i>
                                +1 954-271-9003
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Barra inferior -->
                <div class="dimsop-footer-bottom">
                    <div class="container d-flex flex-wrap justify-content-between align-items-center py-3">
                        <span>&#169; <span t-esc="str(datetime.datetime.now().year)"/> Dimsop. Todos los derechos reservados.</span>
                        <div class="dimsop-social d-flex gap-2">
                            <a t-attf-href="{{ request.env['ir.config_parameter'].sudo().get_param('dimsop.linkedin_url') }}"
                               target="_blank" class="dimsop-social-btn" title="LinkedIn" aria-label="LinkedIn">
                                <i class="fa fa-linkedin" aria-hidden="true"></i>
                            </a>
                            <a t-attf-href="{{ request.env['ir.config_parameter'].sudo().get_param('dimsop.instagram_url') }}"
                               target="_blank" class="dimsop-social-btn" title="Instagram" aria-label="Instagram">
                                <i class="fa fa-instagram" aria-hidden="true"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </footer>
        </xpath>
    </template>
</odoo>
