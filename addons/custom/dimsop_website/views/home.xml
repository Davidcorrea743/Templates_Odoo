                             12. FORMULARIO DE CONTACTO
                             Envía a /dimsop/contacto (controllers/main.py) → crea crm.lead
                             ========================================================= -->
                        <section id="contacto" class="dimsop-section py-5">
                            <div class="container" style="max-width: 720px;">
                                <h2 class="dimsop-h2 text-center mb-2">Contáctanos</h2>
                                <p class="text-center mb-5">Déjanos tus datos y un especialista se pondrá en contacto contigo.</p>
                                <!-- Feedback tras el envío (controllers/main.py redirige con query params) -->
                                <t t-if="request.params.get('mensaje') == 'enviado'">
                                    <div class="alert alert-success dimsop-alert" role="alert">
                                        <i class="fa fa-check-circle me-2" aria-hidden="true"></i>
                                        ¡Mensaje enviado con éxito! Un especialista se pondrá en contacto contigo pronto.
                                    </div>
                                </t>
                                <t t-if="request.params.get('error') == 'datos_incompletos'">
                                    <div class="alert alert-danger dimsop-alert" role="alert">
                                        <i class="fa fa-exclamation-circle me-2" aria-hidden="true"></i>
                                        Por favor completa los campos obligatorios (Nombre y Correo Electrónico).
                                    </div>
                                </t>
                                <form action="/dimsop/contacto" method="post" class="dimsop-form" novalidate="novalidate">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <div class="mb-3">
                                        <label class="form-label" for="dimsop-f-nombre">Nombre y Apellido *</label>
                                        <input type="text" class="form-control" id="dimsop-f-nombre" name="nombre" required="required"/>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label" for="dimsop-f-correo">Correo Electrónico *</label>
                                            <input type="email" class="form-control" id="dimsop-f-correo" name="correo" required="required"/>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label" for="dimsop-f-telefono">Número de Teléfono</label>
                                            <input type="tel" class="form-control" id="dimsop-f-telefono" name="telefono"/>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label" for="dimsop-f-empresa">Empresa</label>
                                            <input type="text" class="form-control" id="dimsop-f-empresa" name="empresa"/>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label class="form-label" for="dimsop-f-cargo">Cargo</label>
                                            <input type="text" class="form-control" id="dimsop-f-cargo" name="cargo"/>
                                        </div>
                                    </div>
                                    <div class="mb-4">
                                        <label class="form-label" for="dimsop-f-servicio">Servicio de Interés</label>
                                        <select name="servicio_interes" id="dimsop-f-servicio" class="form-select">
                                            <option value="cloud">Soluciones en la Nube</option>
                                            <option value="network">Redes</option>
                                            <option value="security">Ciberseguridad</option>
                                            <option value="managed">Servicios Gestionados</option>
                                            <option value="fttx_isp">FTTX/ISP</option>
                                            <option value="unified">Comunicaciones Unificadas</option>
                                            <option value="other">Otro</option>
                                        </select>
                                    </div>
                                    <div class="text-center">
                                        <button type="submit" class="btn btn-dimsop-primary btn-lg">Enviar Mensaje</button>
                                    </div>
                                </form>
                            </div>
                        </section>

                    </div>
                </t>
            </template>

