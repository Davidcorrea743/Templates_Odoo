<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        PÁGINA DE INICIO (Home) - Estructura y Contenido Web V3 - Dimsop
        Secciones:
          1. Header (layout.xml)                   8. Aliados Tecnológicos
          2. Banner principal (video)               9. Contadores de Impacto
          3. Cintillo ISO 9001                     10. Proyectos Referenciales
          4. ¿Quiénes somos?                       11. Blog
          5. Metodología de Trabajo                12. Formulario de Contacto (→ CRM)
          6. Unidades de Negocio                   13. Footer (footer.xml)
          7. Mapa de Cobertura                     14. Botón flotante WhatsApp (JS)

        ASSETS / RECURSOS (colocar los archivos en):
          - Video banner : dimsop_website/static/src/video/banner_principal.mp4
          - Logos aliados: dimsop_website/static/src/img/logos/aliados/
          - Proyectos    : dimsop_website/static/src/img/projects/
          - Metodología  : dimsop_website/static/src/img/methodology/metodologia.png
          - Iconos/social: dimsop_website/static/src/img/social/
    -->
    <template id="dimsop_homepage_view" name="Dimsop Homepage">
        <t t-call="website.layout">
                    <div id="wrap" class="oe_structure oe_empty">

                        <!-- =========================================================
                             2. BANNER PRINCIPAL
                             Fondo de video: static/src/video/banner_principal.mp4
                             ========================================================= -->
                        <section id="banner" class="dimsop-banner d-flex align-items-center text-white">
                            <video class="dimsop-banner-video" autoplay="true" muted="true" loop="true" playsinline="true"
                                   preload="metadata">
                                <source src="/dimsop_website/static/src/video/banner_principal_2.mp4" type="video/mp4"/>
                            </video>
                            <div class="dimsop-banner-overlay"/>
                            <div class="container text-center position-relative">
                                <!-- Boot sequence eyebrow -->
                                <div class="dimsop-hero-eyebrow">
                                    <span class="dimsop-hero-eyebrow-line"></span>
                                    <span class="dimsop-hero-eyebrow-text">INFRASTRUCTURE / SECURITY / AUTOMATION</span>
                                    <span class="dimsop-hero-eyebrow-line"></span>
                                </div>
                                <h1 class="dimsop-h1 mb-4">
                                    Soluciones TIC de Vanguardia para la continuidad de tu negocio.
                                </h1>
                                <p class="dimsop-lead mx-auto mb-4" style="max-width: 680px;">
                                    Impulsamos la transformación digital con tecnología de vanguardia
                                    y soluciones legadas para la continuidad de tu negocio.
                                </p>
                            </div>
                        </section>

                        <!-- =========================================================
                             3. CINTILLO DE CALIDAD (ISO 9001)
                             ========================================================= -->
                        <section id="iso" class="dimsop-iso py-2 text-center text-white">
                            Rumbo a la certificación ISO 9001 | Compromiso con la calidad y la mejora continua
                        </section>

                        <!-- =========================================================
                             4. ¿QUIÉNES SOMOS? (MISIÓN, VISIÓN Y VALORES)
                             ========================================================= -->
                        <section id="nosotros" class="dimsop-section py-5">
                            <div class="container">
                                <!-- 4.1 Visión General -->
                                <h2 class="dimsop-h2 text-center mb-5">¿Quiénes Somos?</h2>
                                <p class="dimsop-lead text-center mx-auto mb-5" style="max-width: 900px;">
                                    En Dimsop impulsamos la rentabilidad y la continuidad operativa de nuestros
                                    clientes, respaldados por personal altamente calificado e innovadores de la región.
                                </p>

                                <!-- 4.2 Misión y Visión -->
                                <div class="row g-4 mb-5">
                                    <div class="col-lg-6">
                                        <div class="dimsop-card h-100">
                                            <h3 class="dimsop-h3">Misión</h3>
                                            <p>
                                                Apoyar a nuestros clientes y aliados de negocios en las soluciones de
                                                innovación tecnológicas legadas y emergentes, para maximizar la
                                                rentabilidad de sus negocios en una relación de ganancia mutua,
                                                contando con personal altamente calificado e innovadores de la región.
                                            </p>
                                        </div>
                                    </div>
                                    <div class="col-lg-6">
                                        <div class="dimsop-card h-100">
                                            <h3 class="dimsop-h3">Visión</h3>
                                            <p>
                                                Ser líder en el desarrollo de soluciones TIC´s basadas en las tecnologías
                                                de innovación emergentes como internet of things (IoT), la visión
                                                computarizada (digitalización), la realidad virtual, la inteligencia
                                                artificial y las criptotecnologías, entre otras.
                                            </p>
                                        </div>
                                    </div>
                                </div>

                                <!-- 4.3 Valores Corporativos -->
                                <h3 class="dimsop-h3 text-center mb-2">Nuestros Valores</h3>
                                <p class="text-center mb-4">Los principios que guían cada proyecto que entregamos.</p>
                                <div class="row g-3 justify-content-center">
                                    <div class="col-6 col-md-4 col-lg">
                                        <div class="dimsop-value"><i class="fa fa-eye dimsop-value-icon"></i><span>Transparencia</span></div>
                                    </div>
                                    <div class="col-6 col-md-4 col-lg">
                                        <div class="dimsop-value"><i class="fa fa-users dimsop-value-icon"></i><span>Trabajos en equipos virtuales</span></div>
                                    </div>
                                    <div class="col-6 col-md-4 col-lg">
                                        <div class="dimsop-value"><i class="fa fa-rocket dimsop-value-icon"></i><span>Uso de tecnologías disruptivas</span></div>
                                    </div>
                                    <div class="col-6 col-md-4 col-lg">
                                        <div class="dimsop-value"><i class="fa fa-leaf dimsop-value-icon"></i><span>Innovación sostenible (verde)</span></div>
                                    </div>
                                    <div class="col-6 col-md-4 col-lg">
                                        <div class="dimsop-value"><i class="fa fa-line-chart dimsop-value-icon"></i><span>Rentabilidad</span></div>
                                    </div>
                                </div>
                            </div>
                        </section>

                        <!-- =========================================================
                             5. METODOLOGÍA DE TRABAJO
                             Infografía: static/src/img/methodology/metodologia.png
                             ========================================================= -->
                        <section id="metodologia" class="dimsop-section py-5 dimsop-section-dark">
                            <div class="container">
                                <h2 class="dimsop-h2 text-center mb-2">Metodología de Trabajo</h2>
                                <p class="text-center text-white mb-5 mx-auto" style="max-width: 780px;">
                                    Nuestro proceso garantiza soluciones efectivas, desde la identificación
                                    de necesidades hasta la entrega de valor tangible para tu negocio.
                                </p>
                                <img src="/dimsop_website/static/src/img/methodology/metodologia.png"
                                     alt="Metodología de trabajo Dimsop" class="img-fluid dimsop-img-methodology mx-auto d-block"/>
                                <div class="row row-cols-lg-5 g-4 mt-2">
                                    <div class="col-md-6 col-lg">
                                        <div class="dimsop-step"><span class="dimsop-step-num">1</span>
                                            <h4>Necesidades del cliente</h4>
                                            <p>Diagnóstico y levantamiento de requerimientos.</p></div>
                                    </div>
                                    <div class="col-md-6 col-lg">
                                        <div class="dimsop-step"><span class="dimsop-step-num">2</span>
                                            <h4>Base instalada</h4>
                                            <p>Evaluación de la infraestructura existente.</p></div>
                                    </div>
                                    <div class="col-md-6 col-lg">
                                        <div class="dimsop-step"><span class="dimsop-step-num">3</span>
                                            <h4>Diseño de solución</h4>
                                            <p>Arquitectura a la medida (legadas y emergentes).</p></div>
                                    </div>
                                    <div class="col-md-6 col-lg">
                                        <div class="dimsop-step"><span class="dimsop-step-num">4</span>
                                            <h4>Propuesta de equipo y servicios</h4>
                                            <p>Selección de equipamiento y alcance técnico.</p></div>
                                    </div>
                                    <div class="col-md-6 col-lg">
                                        <div class="dimsop-step"><span class="dimsop-step-num">5</span>
                                            <h4>Propuesta de valor</h4>
                                            <p>Maximización de rentabilidad y retorno de inversión.</p></div>
                                    </div>
                                </div>
                            </div>
                        </section>

                        <!-- =========================================================
                             6. UNIDADES DE NEGOCIO
                             ========================================================= -->
                        <section id="unidades" class="dimsop-section py-5">
                            <div class="container">
                                <h2 class="dimsop-h2 text-center mb-5">Unidades de Negocio</h2>
                                <div class="row row-cols-lg-3 g-4">
                                    <div class="col">
                                        <div class="dimsop-card h-100">
                                            <i class="fa fa-cloud dimsop-card-icon"></i>
                                            <h3 class="dimsop-h3">Soluciones en la Nube</h3>
                                            <p>Arquitecturas híbridas, privadas y públicas con máxima escalabilidad.</p>
                                        </div>
                                    </div>
                                    <div class="col">
                                        <div class="dimsop-card h-100">
                                            <i class="fa fa-sitemap dimsop-card-icon"></i>
                                            <h3 class="dimsop-h3">Productos y Soluciones de Redes</h3>
                                            <p>Conectividad de alto rendimiento e infraestructura corporativa.</p>
                                        </div>
                                    </div>
                                    <div class="col">
                                        <div class="dimsop-card h-100">
                                            <i class="fa fa-shield dimsop-card-icon"></i>
                                            <h3 class="dimsop-h3">Ciberseguridad Avanzada</h3>
                                            <p>Protección perimetral, detección de amenazas y blindaje de activos.</p>
                                        </div>
                                    </div>
                                    <div class="col">
                                        <div class="dimsop-card h-100">
                                            <i class="fa fa-cogs dimsop-card-icon"></i>
                                            <h3 class="dimsop-h3">Servicios Gestionados</h3>
                                            <p>Monitoreo 24/7 y gestión integral de la infraestructura de TI.</p>
                                        </div>
                                    </div>
                                    <div class="col">
                                        <div class="dimsop-card h-100">
                                            <i class="fa fa-exchange dimsop-card-icon"></i>
                                            <h3 class="dimsop-h3">Soluciones FTTX / ISP</h3>
                                            <p>Despliegue y equipamiento para redes masivas de fibra óptica.</p>
                                        </div>
                                    </div>
                                    <div class="col">
                                        <div class="dimsop-card h-100">
                                            <i class="fa fa-phone dimsop-card-icon"></i>
                                            <h3 class="dimsop-h3">Comunicaciones Unificadas</h3>
                                            <p>Integración de voz, video y colaboración empresarial.</p>
                                        </div>
                                    </div>
                                    <div class="col-lg-4">
                                        <div class="dimsop-card h-100">
                                            <i class="fa fa-microchip dimsop-card-icon"></i>
                                            <h3 class="dimsop-h3">Unidad de Desarrollo e Inteligencia Artificial</h3>
                                            <p>Desarrollo de software, automatización y soluciones con IA.</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>

                        <!-- =========================================================
                             7. MAPA DE COBERTURA
                             Módulo interactivo: resaltar países con presencia.
                             Sustituir por mapa SVG/js personalizado si se desea.
                             ========================================================= -->
                        <section id="cobertura" class="dimsop-section py-5 dimsop-section-dark">
                            <div class="container">
                                <h2 class="dimsop-h2 text-center mb-2">Mapa de Cobertura</h2>
                                <p class="text-center text-white mb-5 mx-auto" style="max-width: 780px;">
                                    Presencia regional con capacidad de despliegue internacional.
                                    Hemos ejecutado proyectos en múltiples países de Latinoamérica y el Caribe.
                                </p>
                                <div id="dimsop-map" class="dimsop-map">
                                    <img src="/dimsop_website/static/src/img/banners/mapa-cobertura.png"
                                         alt="Mapa de cobertura global Dimsop" class="img-fluid"/>
                                </div>
                                <p class="text-center mt-3 text-white">
                                    Países y regiones donde Dimsop ha tenido presencia y despliegue de proyectos.
                                </p>
                            </div>
                        </section>

